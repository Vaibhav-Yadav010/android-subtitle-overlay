<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF7FF"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="18dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@string/app_name"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titleImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CaptionX"
                    android:textColor="#25104D"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/subtitleTagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Understand every conversation"
                    android:textColor="#66577B"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Kept hidden because MainActivity still references this legacy ID. -->
        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            android:contentDescription="@string/settings_title" />

        <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_captionx_card"
            android:backgroundTint="#F0E9FF"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Live Caption &amp; Translation"
                        android:textColor="#25104D"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Real-time subtitles for any audio"
                        android:textColor="#6A5A82"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_captionx_status"
                    android:backgroundTint="#DDF6E8"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="● Ready"
                    android:textColor="#159447"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡  Transcribe speech"
                        android:textColor="#51446B"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="文  Translate in real time"
                        android:textColor="#51446B"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="▰  Show as overlay"
                        android:textColor="#51446B"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="118dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/toggleMainButton"
                        android:layout_width="92dp"
                        android:layout_height="92dp"
                        android:adjustViewBounds="true"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/power"
                        android:scaleType="fitCenter"
                        android:src="@drawable/turn_on" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Start Captioning"
                        android:textColor="#25104D"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_captionx_card"
            android:backgroundTint="#FFFFFF"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙  Quick Setup"
                android:textColor="#25104D"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.example.subtitles.view.CaptionXActionTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_captionx_card"
                    android:backgroundTint="#F7F3FF"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="14dp"
                    android:tag="permission_microphone"
                    android:text="🎙  Microphone\n      Tap to manage"
                    android:textColor="#332A42"
                    android:textSize="13sp" />

                <com.example.subtitles.view.CaptionXActionTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_captionx_card"
                    android:backgroundTint="#F7F3FF"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="14dp"
                    android:tag="permission_overlay"
                    android:text="▰  Overlay\n      Tap to manage"
                    android:textColor="#332A42"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_captionx_card"
            android:backgroundTint="#FFFFFF"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊  Audio Source"
                android:textColor="#25104D"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.example.subtitles.view.CaptionXActionTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_captionx_card"
                    android:backgroundTint="#F7F3FF"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="13dp"
                    android:tag="audio_microphone"
                    android:text="🎙  Microphone"
                    android:textColor="#332A42"
                    android:textSize="13sp" />

                <com.example.subtitles.view.CaptionXActionTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_captionx_card"
                    android:backgroundTint="#EEE5FF"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="13dp"
                    android:tag="audio_system"
                    android:text="▣  System Audio"
                    android:textColor="#3D246F"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="System Audio captures playback from supported videos and apps."
                android:textColor="#756A80"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_captionx_card"
            android:backgroundTint="#FFFFFF"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▥  Transcription Engine"
                android:textColor="#25104D"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.example.subtitles.view.CaptionXActionTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_captionx_card"
                    android:backgroundTint="#F7F3FF"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="13dp"
                    android:tag="engine_remote"
                    android:text="☁  Remote Whisper"
                    android:textColor="#332A42"
                    android:textSize="13sp" />

                <com.example.subtitles.view.CaptionXActionTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_captionx_card"
                    android:backgroundTint="#EEE5FF"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="13dp"
                    android:tag="engine_local"
                    android:text="▣  Local Vosk"
                    android:textColor="#3D246F"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Local Vosk is the active transcription engine in this build."
                android:textColor="#756A80"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_captionx_card"
            android:backgroundTint="#FFFFFF"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="文  Languages"
                    android:textColor="#25104D"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.example.subtitles.view.CaptionXActionTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:tag="swap"
                    android:text="⇄  Swap"
                    android:textColor="#6D4DB3"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Source (spoken)"
                android:textColor="#5F5668"
                android:textSize="12sp" />

            <com.example.subtitles.view.CaptionXActionTextView
                android:id="@+id/sourceLanguageButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_captionx_card"
                android:backgroundTint="#F9F6FF"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp"
                android:tag="source"
                android:text="Auto"
                android:textColor="#332A42"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Target (translation)"
                android:textColor="#5F5668"
                android:textSize="12sp" />

            <com.example.subtitles.view.CaptionXActionTextView
                android:id="@+id/targetLanguageButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_captionx_card"
                android:backgroundTint="#F9F6FF"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp"
                android:tag="target"
                android:text="English"
                android:textColor="#332A42"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="◎  Auto-detect source language"
                    android:textColor="#5F5668"
                    android:textSize="12sp" />

                <com.example.subtitles.view.CaptionXAutoDetectSwitch
                    android:id="@+id/autoDetectSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Auto-detect source language" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/privacyHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_captionx_card"
            android:backgroundTint="#F0E9FF"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Privacy first"
                android:textColor="#25104D"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Audio is processed on-device by the current caption pipeline."
                android:textColor="#756A80"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
